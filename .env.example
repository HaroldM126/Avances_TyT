# Configuración general de Django
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
INITIAL_ADMIN_SETUP_TOKEN=cambia-este-token-inicial

# Base de datos MariaDB / MySQL (Actividad 2)
DB_NAME=parcial_simulador_tyt
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Opciones TLS para MariaDB/MySQL en la nube (opcional)
# DB_SSL_MODE=REQUIRED
# DB_SSL_CA=/ruta/a/ca.pem

# Solo para pruebas locales rápidas sin MariaDB/MySQL:
# DJANGO_USE_SQLITE=1
